Subject: [PATCH] wireguard: reuse crypto worker selection for bounded receive runs

Receive queue entries contain one skb, so rotating through every online
CPU for each enqueue causes excessive workqueue wakeups and cache
movement. Reuse the selected worker for 32 successful receive enqueues.
Use the existing producer index under its existing lock, without a new
shared counter or an unauthenticated packet field. Every enqueue still
queues work; partial runs and isolated packets do not wait for a
threshold. Recheck CPU availability. Transmit entries already contain
batches and retain per-entry rotation. Queue bounds, failure handling,
crypto and per-peer ordering are unchanged.

---
diff --git a/drivers/net/wireguard/queueing.h b/drivers/net/wireguard/queueing.h
--- a/drivers/net/wireguard/queueing.h
+++ b/drivers/net/wireguard/queueing.h
@@ -151,9 +151,9 @@
 
 static inline int wg_queue_enqueue_per_device_and_peer(
 	struct crypt_queue *device_queue, struct prev_queue *peer_queue,
-	struct sk_buff *skb, struct workqueue_struct *wq)
-{
-	int cpu;
+	struct sk_buff *skb, struct workqueue_struct *wq, bool batch_workers)
+{
+	int cpu, ret;
 
 	atomic_set_release(&PACKET_CB(skb)->state, PACKET_STATE_UNCRYPTED);
 	/* We first queue this up for the peer ingestion, but the consumer
@@ -165,8 +165,21 @@
 	/* Then we queue it up in the device queue, which consumes the
 	 * packet as soon as it can.
 	 */
-	cpu = wg_cpumask_next_online(&device_queue->last_cpu);
-	if (unlikely(ptr_ring_produce_bh(&device_queue->ring, skb)))
+	spin_lock_bh(&device_queue->ring.producer_lock);
+	ret = __ptr_ring_produce(&device_queue->ring, skb);
+	cpu = READ_ONCE(device_queue->last_cpu);
+	/* Receive entries contain one datagram. Reuse a worker for a bounded
+	 * run instead of waking a different CPU for every packet. Every entry
+	 * still queues work, including isolated packets and incomplete runs.
+	 * The ring's producer lock protects this choice without another counter.
+	 * Transmit entries already contain batches and retain per-entry rotation.
+	 */
+	if (likely(!ret) && (!batch_workers ||
+			     !(device_queue->ring.producer & 31) ||
+			     cpu < 0 || !cpu_online(cpu)))
+		cpu = wg_cpumask_next_online(&device_queue->last_cpu);
+	spin_unlock_bh(&device_queue->ring.producer_lock);
+	if (unlikely(ret))
 		return -EPIPE;
 	queue_work_on(cpu, wq, &per_cpu_ptr(device_queue->worker, cpu)->work);
 	return 0;
diff --git a/drivers/net/wireguard/receive.c b/drivers/net/wireguard/receive.c
--- a/drivers/net/wireguard/receive.c
+++ b/drivers/net/wireguard/receive.c
@@ -524,7 +524,7 @@
 		goto err;
 
 	ret = wg_queue_enqueue_per_device_and_peer(&wg->decrypt_queue, &peer->rx_queue, skb,
-						   wg->packet_crypt_wq);
+						   wg->packet_crypt_wq, true);
 	if (unlikely(ret == -EPIPE))
 		wg_queue_enqueue_per_peer_rx(skb, PACKET_STATE_DEAD);
 	if (likely(!ret || ret == -EPIPE)) {
diff --git a/drivers/net/wireguard/send.c b/drivers/net/wireguard/send.c
--- a/drivers/net/wireguard/send.c
+++ b/drivers/net/wireguard/send.c
@@ -377,7 +377,7 @@
 		goto err;
 
 	ret = wg_queue_enqueue_per_device_and_peer(&wg->encrypt_queue, &peer->tx_queue, first,
-						   wg->packet_crypt_wq);
+						   wg->packet_crypt_wq, false);
 	if (unlikely(ret == -EPIPE))
 		wg_queue_enqueue_per_peer_tx(first, PACKET_STATE_DEAD);
 err:
